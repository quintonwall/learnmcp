{
  "name": "@learnmcp/server",
  "version": "0.1.0",
  "description": "learnmcp engine: runtime cartridge registry (hot-loading) + detection engine.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "learnmcp-server": "./dist/bin.js",
    "learnmcp": "./dist/cli.js"
  },
  "files": ["dist", "cartridges"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node -e \"require('node:fs').cpSync('../../cartridges','cartridges',{recursive:true})\"",
    "postpack": "node -e \"require('node:fs').rmSync('cartridges',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@learnmcp/schema": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chokidar": "^4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
