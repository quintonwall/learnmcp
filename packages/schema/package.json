{
  "name": "@learnmcp/schema",
  "version": "0.1.0",
  "description": "Cartridge schema, matcher vocabulary, and the pure detection evaluator.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cartridge.schema.json": "./cartridge.schema.json"
  },
  "files": [
