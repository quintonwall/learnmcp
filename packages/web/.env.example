# Copy to .env.local (gitignored) and fill in. The same set goes into Vercel under
# Project Settings → Environment Variables. See HOSTING.md.
#
# With none of these set the app still runs: the gallery falls back to the repo's
# cartridges/ directory, and /mcp returns 503.

# --- Client: gallery + leaderboard ------------------------------------------------
# The anon key is public by design and RLS-gated; safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server: the remote MCP endpoint (/mcp) ---------------------------------------
SUPABASE_URL=
# service_role — bypasses RLS, because the MCP server writes progress for anonymous
# learners who have no auth.uid(). Server-only; never prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Fine-grained PAT, public-repo read. Unauthenticated GitHub is 60 req/hour per IP,
# shared across every learner hitting your server; a token raises it to 5,000.
GITHUB_TOKEN=

# --- Optional: point the cartridge registry elsewhere -----------------------------
# LEARNMCP_CARTRIDGE_REPO=quintonwall/learnmcp
# LEARNMCP_CARTRIDGE_REF=main
# LEARNMCP_CARTRIDGE_PATH=cartridges
