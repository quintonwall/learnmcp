{
  "id": "linear",
  "version": "1.0.0",
  "trust": "official",
  "provider": {
    "name": "Linear",
    "homepage": "https://linear.app",
    "icon": "\ud83d\udcd0"
  },
  "detect": [
    {
      "type": "mcp",
      "server": "linear"
    },
    {
      "type": "dependency",
      "name": "@linear/sdk"
    }
  ],
  "objectives": [
    {
      "id": "see-your-work",
      "title": "See what's assigned to you",
      "why": "Starting from the board beats starting from memory.",
      "badge": "oriented",
      "criteria": {
        "type": "mcp_tool",
        "server": "linear",
        "tool": "(list|get|search)_?[Ii]ssues?"
      },
      "docs": "https://linear.app/docs/list-view"
    },
    {
      "id": "create-an-issue",
      "title": "Capture work as an issue",
      "why": "Work that isn't written down is work only you can do.",
      "badge": "scribe",
      "criteria": {
        "type": "mcp_tool",
        "server": "linear",
        "tool": "create_?[Ii]ssue"
      },
      "docs": "https://linear.app/docs/creating-issues"
    },
    {
      "id": "groom-an-issue",
      "title": "Add detail: estimate, labels, priority",
      "why": "An issue without context gets picked up by nobody, twice.",
      "badge": "groomer",
      "criteria": {
        "type": "mcp_tool",
        "server": "linear",
        "tool": "update_?[Ii]ssue"
      },
      "docs": "https://linear.app/docs/issue-properties"
    },
    {
      "id": "comment",
      "title": "Discuss on the issue, not in DMs",
      "why": "A decision in a DM is a decision the team loses.",
      "badge": "in-the-open",
      "criteria": {
        "type": "mcp_tool",
        "server": "linear",
        "tool": "create_?[Cc]omment"
      },
      "docs": "https://linear.app/docs/comments"
    },
    {
      "id": "use-projects",
      "title": "Group work into a project or cycle",
      "why": "Projects are how a pile of issues becomes a plan.",
      "badge": "planner",
      "criteria": {
        "type": "mcp_tool",
        "server": "linear",
        "tool": "(create|update|list)_?(Project|Cycle|project|cycle)s?"
      },
      "docs": "https://linear.app/docs/projects"
    },
    {
      "id": "link-branch-to-issue",
      "title": "Name your branch after the issue",
      "why": "Linear closes the loop automatically when the branch and issue match.",
      "badge": "joined-up",
      "criteria": {
        "type": "bash",
        "matches": "git\\s+(checkout\\s+-b|switch\\s+-c)\\s+\\S*[a-zA-Z]{2,}-\\d+"
      },
      "docs": "https://linear.app/docs/github"
    },
    {
      "id": "close-the-loop",
      "title": "Move an issue to done",
      "why": "Status that reflects reality is the only status worth having.",
      "badge": "closer",
      "criteria": {
        "type": "mcp_tool",
        "server": "linear",
        "tool": "(update_?[Ii]ssue|create_?[Ii]ssue_?[Ss]tatus)"
      },
      "docs": "https://linear.app/docs/workflows"
    }
  ],
  "bestPractices": [
    {
      "id": "api-key-not-committed",
      "title": "Keep your Linear API key out of git",
      "why": "A leaked key is write access to your team's whole backlog.",
      "badge": "key-safe",
      "criteria": {
        "type": "env",
        "key": "LINEAR_API_KEY",
        "absent_from": "git"
      },
      "recommended": true
    },
    {
      "id": "issues-are-actionable",
      "title": "Write issues someone else could pick up",
      "why": "A title like 'fix the thing' costs more to triage than to write properly.",
      "badge": "clear-writer",
      "criteria": {
        "type": "llm_judge",
        "over": {
          "file": "**/{CLAUDE,AGENTS,CONTRIBUTING}.md"
        },
        "rubric": "Do the project rules describe how to write an actionable issue \u2014 context, expected behaviour, and acceptance criteria?",
        "confidence_gte": 0.8
      },
      "recommended": true
    }
  ],
  "badges": [
    {
      "id": "oriented",
      "name": "Oriented",
      "tier": "bronze",
      "description": "Started from the board."
    },
    {
      "id": "scribe",
      "name": "Scribe",
      "tier": "bronze",
      "description": "Captured work as an issue."
    },
    {
      "id": "groomer",
      "name": "Groomer",
      "tier": "silver",
      "description": "Gave an issue real detail."
    },
    {
      "id": "in-the-open",
      "name": "In The Open",
      "tier": "bronze",
      "description": "Discussed on the issue."
    },
    {
      "id": "planner",
      "name": "Planner",
      "tier": "silver",
      "description": "Grouped work into a project or cycle."
    },
    {
      "id": "joined-up",
      "name": "Joined Up",
      "tier": "silver",
      "description": "Linked a branch to an issue."
    },
    {
      "id": "closer",
      "name": "Closer",
      "tier": "bronze",
      "description": "Moved an issue to done."
    },
    {
      "id": "key-safe",
      "name": "Backlog Key",
      "tier": "bronze",
      "description": "Keeps the Linear key out of git."
    },
    {
      "id": "clear-writer",
      "name": "Clear Writer",
      "tier": "gold",
      "description": "Issues anyone could pick up."
    },
    {
      "id": "backlog-tamer",
      "name": "Backlog Tamer",
      "tier": "gold",
      "description": "Created 25 issues.",
      "criteria": {
        "type": "mcp_tool",
        "server": "linear",
        "tool": "create_?[Ii]ssue",
        "gte": 25
      }
    }
  ]
}
